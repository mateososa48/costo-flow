# =============================================================================
# CostoFlow — Required Environment Variables
# Copy this file to .env.local and fill in the values before running/deploying.
# NEVER commit .env.local to git.
# =============================================================================

# --- Auth ---
# Comma-separated list of admin names shown in the login dropdown
ADMIN_NAMES="Maria,Juan,Sofia,Carlos"
# Shared password for all admins
SHARED_PASSWORD="costoflow-dev-password"
# At least 32 random characters — used to sign/encrypt session cookies
SESSION_PASSWORD="replace-this-with-at-least-32-random-chars-!!"

# --- OpenAI ---
OPENAI_API_KEY="sk-..."
# Model for invoice extraction (must support vision/images)
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets (Service Account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL="invoice-bot@your-gcp-project.iam.gserviceaccount.com"
# Paste the private_key value from your service account JSON.
# In .env.local, you can paste it with literal \n characters, e.g.:
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"

# --- Sheet Registry ---
# One Spreadsheet ID per (restaurant, year, month) combination.
# Key format: {restaurant}_{YYYY}_{MM}  e.g. motin_juarez_2025_01
# Share each spreadsheet with the service account email above (Editor role).
#
# Example (JSON string — single line, no extra whitespace):
SHEET_REGISTRY='{"motin_juarez_2025_01":"SPREADSHEET_ID_HERE","motin_roma_2025_01":"SPREADSHEET_ID_HERE","queseria_2025_01":"SPREADSHEET_ID_HERE"}'

# --- Audit Log ---
# A separate Google Spreadsheet used to log every submission.
# Share it with the service account (Editor role).
AUDIT_LOG_SPREADSHEET_ID="SPREADSHEET_ID_HERE"

# --- Admin Endpoints ---
# Secret token required to call one-time admin endpoints (e.g. POST /api/admin/seed-catalogo)
ADMIN_SEED_SECRET=
